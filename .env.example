# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=mglaroute
DB_PASSWORD=replace-with-strong-random
DB_NAME=mglaroute
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-strong-random
REDIS_DB=0

# JWT
JWT_SECRET=change-this-in-production

# Server
TZ=Europe/Moscow
PORT=3000
FRONTEND_URL=http://localhost:5173

# Production (optional)
BACKEND_PORT=3000
FRONTEND_PORT=80

# Domain routing (Caddy reverse proxy)
# External nginx proxy manager terminates TLS and forwards to Caddy on CADDY_PORT
COMMON_DOMAIN=ashen-hermit.space
PANEL_SUBDOMAIN=admin.mglaroute
BACKEND_SUBDOMAIN=api.mglaroute
CADDY_PORT=8080