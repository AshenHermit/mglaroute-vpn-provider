# Caddy reverse proxy template for mglaroute-vpn-server
# Rendered at container start by awk in docker-compose (see caddy.command).
# Placeholders are {NAME} and must match the caddy service environment.
#
#   COMMON_DOMAIN       root domain (ashen-hermit.space)
#   PANEL_SUBDOMAIN     admin panel subdomain (admin.mglaroute)
#   BACKEND_SUBDOMAIN   API subdomain (api.mglaroute)
#   BACKEND_HOST        backend container hostname (backend)
#   FRONTEND_HOST       frontend container hostname (frontend)
#   BACKEND_PORT        backend port (3000)
#   FRONTEND_PORT       frontend port (80 in prod)
#
# TLS is terminated by the external nginx proxy manager. Caddy listens on
# plain HTTP and routes by Host. CORS is handled by NestJS (FRONTEND_URL),
# not here — Caddy's respond directive cannot set Access-Control-* headers.

{
	auto_https off
}

{PANEL_SUBDOMAIN}.{COMMON_DOMAIN} {
	reverse_proxy {FRONTEND_HOST}:{FRONTEND_PORT}
}

{BACKEND_SUBDOMAIN}.{COMMON_DOMAIN} {
	reverse_proxy {BACKEND_HOST}:{BACKEND_PORT}
}
